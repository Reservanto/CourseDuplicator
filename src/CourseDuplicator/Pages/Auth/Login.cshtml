@page
@model CourseDuplicator.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}

<div class="auth-card">
    <h2 class="auth-card__title">Přihlášení</h2>
    <p class="auth-card__text">
        Pro práci s kurzy se přihlaste svým účtem Reservanto.
        Budete přesměrováni na Reservanto, kde aplikaci udělíte přístup.
    </p>
    <form method="post" asp-page-handler="Start">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <button class="button" type="submit">Přihlásit se přes Reservanto</button>
    </form>
</div>
