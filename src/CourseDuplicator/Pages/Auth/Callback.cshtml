@page
@model CourseDuplicator.Pages.Auth.CallbackModel
@{
    ViewData["Title"] = "Autorizace";
}

<div class="auth-card">
    @if (Model.Denied)
    {
        <h2 class="auth-card__title">Autorizace zamítnuta</h2>
        <p class="auth-card__text">
            Bez udělení přístupu nemůže aplikace s vašimi kurzy pracovat.
        </p>
    }
    else
    {
        <h2 class="auth-card__title">Přihlášení se nezdařilo</h2>
        <p class="auth-card__text">@Model.Error</p>
    }
    <a class="button" asp-page="/Auth/Login">Zkusit znovu</a>
</div>
