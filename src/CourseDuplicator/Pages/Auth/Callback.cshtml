@page
@model CourseDuplicator.Pages.Auth.CallbackModel
@{
    ViewData["Title"] = "Autorizace";
}

<div class="rds-card auth-card">
    <div class="rds-card__body auth-card__body">
        @if (Model.Denied)
        {
            <h1 class="rds-h1">Autorizace zamítnuta</h1>
            <p class="auth-card__text">
                Bez udělení přístupu nemůže aplikace s vašimi kurzy pracovat.
            </p>
        }
        else
        {
            <h1 class="rds-h1">Přihlášení se nezdařilo</h1>
            <p class="auth-card__text">@Model.Error</p>
        }
        <a class="rds-btn rds-btn--primary" asp-page="/Auth/Login">Zkusit znovu</a>
    </div>
</div>
