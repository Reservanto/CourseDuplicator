@page
@model ErrorModel
@{
    ViewData["Title"] = "Chyba";
}

<section class="rds-card">
    <div class="rds-card__body">
        <h2 class="rds-h2">Došlo k chybě</h2>
        <p class="rds-muted">Při zpracování požadavku došlo k neočekávané chybě.</p>
        @if (Model.RequestId is not null)
        {
            <p class="rds-muted">Request ID: <code class="rds-mono">@Model.RequestId</code></p>
        }
    </div>
</section>
