@page
@model ApiTestModel
@{
    ViewData["Title"] = "Test API";
}

<h2>Test Reservanto API</h2>
<p class="hint">Ruční ověření autentizace a API klienta: zadejte LongTimeToken, aplikace z něj získá ShortTimeToken a načte seznam segmentů.</p>

<form method="post" asp-page-handler="Test">
    <div class="form-field">
        <label class="form-field__label" for="ltt">LongTimeToken</label>
        <input class="form-field__input" type="text" id="ltt" name="LongTimeToken"
               value="@Model.LongTimeToken" autocomplete="off" required />
    </div>
    <button class="button" type="submit">Test GetSegments</button>
</form>

@if (Model.Error is not null)
{
    <div class="result">
        <h3>Chyba</h3>
        <pre class="result__output result__output--error">@Model.Error</pre>
    </div>
}
@if (Model.ResultJson is not null)
{
    <div class="result">
        <h3>Segmenty</h3>
        <pre class="result__output">@Model.ResultJson</pre>
    </div>
}
