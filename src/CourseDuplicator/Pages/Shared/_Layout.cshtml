<!DOCTYPE html>
@inject CourseDuplicator.Services.AuthService Auth
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} – Course Duplicator" : "Course Duplicator")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <h1 class="header__title"><a class="header__link" href="/">Course Duplicator</a></h1>
        <div class="header__auth">
            @if (Auth.IsAuthenticated)
            {
                <span class="header__auth-status">přihlášen</span>
                <form class="header__logout-form" method="post" asp-page="/Auth/Logout">
                    <button class="button button--secondary" type="submit">Odhlásit</button>
                </form>
            }
            else
            {
                <a class="button button--secondary" asp-page="/Auth/Login">Přihlásit se</a>
            }
        </div>
    </header>
    <main class="main">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
